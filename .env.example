# Supabase Marketplace keys. The publishable key is public; the secret key is server-only.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy fallbacks for projects that still use anon/service_role keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for live giver dialogue. The model defaults to claude-sonnet-5.
# Never expose this key in NEXT_PUBLIC_* or Git.
ANTHROPIC_API_KEY=
# Optional override; use an exact model ID available to your Anthropic account.
ANTHROPIC_MODEL=

# Required to protect the researcher dashboard.
ADMIN_PASSWORD=
# Set a random secret to keep participant sessions stable when Supabase keys rotate.
PARTICIPANT_SESSION_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
