# Supabase Marketplace keys. The publishable key is public; the secret key is server-only.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy fallbacks for projects that still use anon/service_role keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude Messages API (server only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# controlled | live (live is demonstration only)
EXPERIMENT_CANDIDATE_MODE=controlled
ADMIN_PASSWORD=
PARTICIPANT_SESSION_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
